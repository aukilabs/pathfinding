      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "earcut": "^3.0.2",
    "recast-navigation": "^0.43.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
