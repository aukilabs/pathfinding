{
  "name": "@auki/pathfinding",
  "version": "0.1.1",
  "description": "Hybrid pathfinding library combining navigation graphs with Recast/Detour NavMeshes",
  "keywords": [
    "pathfinding",
    "navigation",
    "navmesh"
  ],
  "author": "Jason Yankowski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aukilabs/pathfinding.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
